# Secretos de las Edge Functions. NO se suben a GitHub: se cargan con
#   supabase secrets set --env-file supabase/.env --project-ref TU_REF
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de la IA (opcional). Por defecto claude-opus-5-5; claude-sonnet-5-5 cuesta menos por consulta.
# CRM_IA_MODEL=claude-sonnet-5-5
# CRM_IA_LIMITE_HORA=40
# Opcional: restringe CORS a tu dominio (ej. https://app.gpunlock.com)
# CRM_ALLOWED_ORIGIN=https://app.gpunlock.com

# Avisos de cobro por correo (función cobros-avisos; ver supabase/functions/cobros-avisos/README.md)
# RESEND_API_KEY=re_...
# AVISOS_FROM="GPUnlock <avisos@tudominio.com>"
# CRON_SECRET=una-clave-larga-al-azar
# AVISOS_REPLY_TO=cobros@tudominio.com
